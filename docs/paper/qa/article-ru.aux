\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Редактор коннектома со схемами D (сверху) и M (снизу), поставленными на паузу сразу после импорта. Это разные целостные конструкции; M не получена в данном эксперименте простым добавлением двух модулирующих связей к неизменной D.\relax }}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:small}{{3}{6}{Редактор коннектома со схемами D (сверху) и M (снизу), поставленными на паузу сразу после импорта. Это разные целостные конструкции; M не получена в данном эксперименте простым добавлением двух модулирующих связей к неизменной D.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Схема G в редакторе: 12 групп по 64 нейрона, периферические сенсорные и моторные нейроны, межпопуляционные проекции. Исходные подписи отражают предполагаемые функции, но не являются независимым доказательством специализации. Плотное расположение подписей сохранено таким, каким оно отображается в существующем редакторе.\relax }}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ganglia}{{4}{7}{Схема G в редакторе: 12 групп по 64 нейрона, периферические сенсорные и моторные нейроны, межпопуляционные проекции. Исходные подписи отражают предполагаемые функции, но не являются независимым доказательством специализации. Плотное расположение подписей сохранено таким, каким оно отображается в существующем редакторе.\relax }{figure.caption.5}{}}
