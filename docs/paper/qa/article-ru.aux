\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Предлагаемая последовательность относится к средствам проектирования. Модуляция добавляет динамическое состояние чувствительности; ганглии предоставляют организацию популяций и сокращённое описание проекций. Стрелки не обозначают установленную историческую последовательность эволюции животных.\relax }}{2}{figure.caption.1}\protected@file@percent }
