{
  "name": "spiking-bug-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:environment": "vite --config apps/environment/vite.config.ts",
    "dev:editor": "vite --config apps/editor/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/environment/vite.config.ts && vite build --config apps/editor/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "prettier": "3.8.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
